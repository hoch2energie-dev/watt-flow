# Produktionswerte. Nach .env kopieren und ausfüllen.
# scripts/install.sh liest diese Datei und startet den Stack ohne Rückfragen.
# Passwörter ohne Leerzeichen und ohne die Zeichen @ : / # ? % $

# Öffentlicher Name. Der DNS-A-Eintrag muss auf den Server zeigen,
# damit Let's Encrypt das Zertifikat ausstellen kann.
DOMAIN=angebote.hoch2energie.de

# E-Mail für das Let's-Encrypt-Konto (Ablaufhinweise).
ACME_EMAIL=r.gress@hoch2energie.de

POSTGRES_USER=hoch2
POSTGRES_PASSWORD=hier-langes-datenbankpasswort
POSTGRES_DB=hoch2

# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 36
AUTH_SECRET=hier-mindestens-32-zeichen-langer-zufallswert

# Erstes Administrationskonto. Das Passwort wird nur angelegt, wenn das Konto noch fehlt.
ADMIN_EMAIL=r.gress@hoch2energie.de
ADMIN_PASSWORD=hier-mindestens-10-zeichen
ADMIN_NAME=Rudolf Gress

# Beispielkunden, Beispielkatalog und Hinweis auf der Anmeldeseite.
# Auf dem Produktivserver false lassen. install.sh bricht bei true ab.
SEED_DEMO=false
SHOW_DEMO_LOGIN=false
COOKIE_SECURE=true

# Google Maps Platform (freiwillig). Ohne diese Werte arbeitet das Programm wie bisher.
# Einrichtung Schritt für Schritt: docs/google-maps.md
# Server-Schlüssel: Adressvorschläge (Places API (New)) und Standortsuche (Geocoding API).
# In der Google Cloud auf die IP-Adresse dieses Servers beschränken.
GOOGLE_MAPS_SERVER_KEY=
# Browser-Schlüssel: Karte im Angebot (Maps JavaScript API). Ist im Browser sichtbar,
# deshalb in der Google Cloud auf https://DOMAIN/* beschränken.
GOOGLE_MAPS_BROWSER_KEY=
